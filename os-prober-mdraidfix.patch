 		echo "$(LVM_SUPPRESS_FD_WARNINGS=1 log_output lvs --noheadings --separator : -o vg_name,lv_name |
@@ -127,7 +132,7 @@ if [ -f /proc/swaps ]; then
 fi
 : >"$OS_PROBER_TMP/raided-map"
